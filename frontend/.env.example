# Frontend Environment Configuration Template
# Local development default:
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Production AWS Amplify configuration:
# Set VITE_API_BASE_URL in AWS Amplify Console > App settings > Environment variables
# Point to your production Django API backend (e.g. AWS App Runner service URL):
# VITE_API_BASE_URL=https://your-service.awsapprunner.com/api
