# ==============================================================================
# Environment Configuration Template for Campus Hiring Platform (Backend)
# Copy this file to '.env' and update the values for your local environment.
# DO NOT commit the actual '.env' file containing real credentials to version control.
# ==============================================================================

# Database Settings (MySQL 8.0+ / Amazon RDS)
DB_NAME=campus_hiring_db
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Database Connection Pooling & Timeouts (Optional)
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10
# DB_CONN_HEALTH_CHECKS=True

# Amazon RDS SSL / TLS Configuration (Optional for local dev; recommended for Amazon RDS)
# Path to Amazon RDS CA bundle (e.g., /etc/ssl/certs/global-bundle.pem)
# When DB_SSL_CA is configured, DB_SSL_MODE defaults to VERIFY_IDENTITY (strict cert & hostname check)
# DB_SSL_CA=/path/to/global-bundle.pem
# DB_SSL_MODE=VERIFY_IDENTITY
# DB_SSL_REQUIRE=True


# Django Application Settings
# DEBUG defaults to False if unset or empty (safe for production). Set to True for local development.
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-32-chars-min
# Comma-separated allowed hosts (e.g., 127.0.0.1,localhost or your-service.awsapprunner.com)
ALLOWED_HOSTS=127.0.0.1,localhost

# Reverse-Proxy SSL & Production Cookie Security (Optional for local dev; recommended for AWS App Runner)
# Set USE_SECURE_PROXY_SSL_HEADER=True when running behind AWS App Runner or ALB (TLS terminated at proxy)
# USE_SECURE_PROXY_SSL_HEADER=True
# In production (DEBUG=False), SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE default to True automatically.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# Set SECURE_SSL_REDIRECT=True if HTTPS redirection should be enforced at Django level
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000


# CORS Allowed Origins (comma-separated frontend URLs)
# In local development, defaults to localhost:5173, localhost:3000 if omitted.
# In production, set to your AWS Amplify domain (e.g., https://main.d123456789.amplifyapp.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Amazon S3 Resume Storage (Optional - omit or leave empty for local filesystem storage)
# When configured, student resumes will be uploaded to a private Amazon S3 bucket.
# AWS_STORAGE_BUCKET_NAME=your-private-s3-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_QUERYSTRING_EXPIRE=3600
# AWS credentials below are optional; prefer IAM instance/task role in AWS App Runner
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
